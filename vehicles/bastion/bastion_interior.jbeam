{
"bastion_dash": {
    "information":{
        "authors":"BeamNG",
        "name":"Interior",
        "value":2200,
    },
    "slotType" : "bastion_dash",
    "slots2":[
        ["name",                   "allowTypes",               "denyTypes", "default",             "description"],
        ["bastion_sunvisors",      ["bastion_sunvisors"],      [],          "bastion_sunvisors",   "Sunvisors"],
        ["bastion_shifter",        ["bastion_shifter"],        [],          "bastion_shifter_A",   "Shifter",             {"coreSlot":true}],
        ["bastion_gauges",         ["bastion_gauges"],         [],          "bastion_gauges_luxe", "Gauge",               {"coreSlot":true}],
        ["bastion_console",        ["bastion_console"],        [],          "bastion_console",     "Center Console",      {"coreSlot":true}],
        ["bastion_dash_accessory", ["bastion_dash_accessory"], [],          "",                    "Dashboard Accessory"],
        ["bastion_partition",      ["bastion_partition"],      [],          "",                    "Rear Partition"],
        ["bastion_shiftlight",     ["bastion_shiftlight"],     [],          "",                    "Shift Light"],
        ["bastion_seat_FR",        ["bastion_seat_FR"],        [],          "bastion_seat_FR",     "Passenger Seat"],
        ["bastion_seat_FL",        ["bastion_seat_FL"],        [],          "bastion_seat_FL",     "Driver Seat",        {"variables":{"$isDriver":"LHD"}}],
        ["bastion_seats_R",        ["bastion_seats_R"],        [],          "bastion_seats_R",     "Rear Seats"],
        ["soundscape_horn",        ["soundscape_horn"],        [],          "soundscape_horn_6",   "Horn"],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["bastion_dash", ["bastion_dash"]],
        ["bastion_center_mirror", ["bastion_body"]],
        ["bastion_center_mirrorglass", ["bastion_body"]],
        ["bastion_roof_console", ["bastion_body"]],
        {"deformGroup":"display_break", "deformMaterialBase":"bastion_gps_screen", "deformMaterialDamaged":"bastion_gauges_break"},
        ["bastion_gps_screen", ["bastion_dash"]],
        ["bastion_gauges_screen", ["bastion_dash"]],
        {"deformGroup":""},
    ],
    "triggers2":[
      ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
      ["headlights",   "dshl","dsh","int_strw","sphere", 0.030,                      {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.160, "y":-0.020, "z":-0.033}, {"color":[1, 0.5, 0, 1]}],
      ["sw_ignition",  "dshl","dsh","int_strw","sphere", 0.030,                      {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.147, "y":-0.030, "z":-0.050}, {"color":[1, 0.5, 0, 1]}],
      ["toggleESCMode","dshl","dsh","int_strw","sphere", 0.027,                      {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.393, "y":-0.010, "z": 0.012}, {"color":[1, 0.5, 0, 1]}],
      ["hazard",       "dshl","dsh","int_strw","box",{"x":0.040,"y":0.035,"z":0.035},{"x":40,"y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.374, "y":-0.025, "z":-0.105}, {"color":[1, 0.5, 0, 1]}],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["headlights", "action0", "common:toggle_headlights"],
        ["hazard", "action0", "common:toggle_hazard_signal"],
        ["toggleESCMode", "action0", "common:toggleESCMode"],
        ["sw_ignition", "action0", "common:activateStarterMotor"],
        ["sw_ignition", "action2", "common:setIgnitionLevel3Momentary"],
    ],
    "actionsEnabled": [
        ["id", "name"],
        ["toggle_study_gauges", "toggle_study_gauges"],
    ],
    "mirrors": [
        ["mesh", "idRef:", "id1:", "id2:"],
        ["bastion_center_mirrorglass","rf1","rf1r","rf2",{"refBaseTranslation":{"x":0.01,"y":-0.08,"z":-0.135},"baseRotationGlobal":{"x":3.9,"y":0.0,"z":8.8}}],
    ],
    "glowMap":{
        "bastion_gauges_screen":{"simpleFunction":{"ignitionLevel":0.1, "lowhighbeam":1}, "off":"screen_off", "on":"bastion_gauges_screen", "on_intense":"bastion_gauges_screen_dim"},
    },
    "controller": [
        ["fileName"],
        ["beamNavigator", {"screenMaterialName": "@bastion_gps_screen", "htmlFilePath": "local://local/vehicles/common/navi_screen.html", "name":"bastion_navi"}],
        ["studyGaugeToggle", {"name":"studyGaugeToggle"}],
        ["gauges/genericGauges", {"name":"gauge", }],
        ["gauges/customModules/environmentData"],
        ["gauges/customModules/combustionEngineData"],
        ["gauges/customModules/accelerationData"],
    ],
    "gauge": {
        "configuration": {
            "materialName": "@bastion_gauges_screen"
            "htmlPath": "local://local/vehicles/bastion/gauges_screen/gauge_standard.html"
            "displayWidth":512
            "displayHeight":512
        }
        "displayData": {
            "electrics": [
                "gear",
                "fuel",
                "watertemp",
                "wheelspeed",
                "linelock",
                "transbrake",
                "odometer",
                "trip",
                "ignitionLevel",
                "study_hide_gauges"
            ]
            "customModules": [
                ["moduleName", "property"]
                ["environmentData", "time"],
                ["accelerationData", "accelerationSmooth"]
                ["combustionEngineData", "currentPower"]
            ]
        },
    },
    "props": [
        ["func",       "mesh",               "idRef:", "idX:", "idY:",  "baseRotation",            "rotation",               "translation",          "min", "max", "offset", "multiplier"],
        //steering column controls
        ["turnsignal", "bastion_turn_signal_stalk", "dshl","dsh","int_strw", {"x": 90, "y":0, "z":180}, {"x":0, "y":-10, "z":0},  {"x":0, "y":0, "z":0},  -1, 1, -0.0, 1],
        //pedals
        ["throttle",   "bastion_pedal_gas",   "f1l","f1r","f6l",         {"x":0, "y":0, "z":180},   {"x":-25, "y":0, "z":0},  {"x":0.0, "y":0, "z":0}, 0, 1, 0,    1],
    ],
    "soundscape": [
        ["name", "src"],
        //indicator6,
        {"node:":"int_strw"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>SUB_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>SUB_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>POL_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>POL_Clack"],
        //lights11
        ["LightOn", "event:>Vehicle>Interior>Light>POL_Light_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>POL_Light_Off"],
        //handbrake2
        {"node:":"int_pbrk"},
        ["handbrakeDisengaged","event:>Vehicle>Interior>Handbrake_Electric>Electric_01_Unlock"],
        ["handbrakeEngaging","event:>Vehicle>Interior>Handbrake_Electric>Electric_01_Lock"],
        //affects horn location because horn soundscape is loaded after
        {"node:":"f15"},
    ],
    "nodes": [
         ["id",       "posX", "posY", "posZ"],
         {"collision":true},
         {"selfCollision":false},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         //dashboard
         {"group":"bastion_dash"},
         {"nodeWeight":12},
         ["dshr",    -0.393, -0.60,   0.87],
         ["dsh",      0.00,  -0.60,   0.87],
         ["dshl",     0.393, -0.60,   0.87],
         {"nodeWeight":1},
         ["int_strw", 0.393, -0.53,   0.90],
         {"group":""},
         {"nodeWeight":0.2},
         ["int_pbrk", 0.05,  -0.23,   0.56],
         ["int_shft", 0.05,  -0.40,   0.56],
    ],
    "torsionbars":[
       ["id1:", "id2:", "id3:", "id4:"],
        //rigify the column
        {"spring":20000, "damp":1, "deform":18000, "strength":28000},
        ["int_strw", "dshl", "dsh", "f5l"],

    ],
    "beams":[
          ["id1:",     "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"deformLimitExpansion":""},
          {"deformGroup":"display_break","deformationTriggerRatio":0.05},
          //dash board
          {"beamSpring":869146.6,"beamDamp":142.73},
          {"beamDeform":12400,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          ["dshr",     "f5r"],
          ["dshl",     "f5l"],
          ["dshr",     "f6r"],
          ["dshl",     "f6l"],
          ["dshr",     "f1r"],
          ["dshl",     "f1l"],
          ["dshr",     "f5rr"],
          ["dshl",     "f5ll"],
          ["dshr",     "f6rr"],
          ["dshl",     "f6ll"],
          ["dshl",     "dshr"],
          ["dsh",      "f5r"],
          ["dsh",      "f5l"],
          ["dsh",      "f6r"],
          ["dsh",      "f6l"],
          ["dsh",      "f1r"],
          ["dsh",      "f1l"],
          ["dshl",     "dsh"],
          ["dshr",     "dsh"],
          ["dsh",      "int_strw"],
          ["dshl",     "int_strw"],
          {"beamSpring":160100,"beamDamp":142.73},
          {"beamDeform":70300,"beamStrength":"FLT_MAX"},
          ["int_pbrk", "f5l"],
          ["int_pbrk", "f5r"],
          ["int_pbrk", "f2r"],
          ["int_pbrk", "f2l"],
          ["int_shft", "f5l"],
          ["int_shft", "f5r"],
          ["int_shft", "f2r"],
          ["int_shft", "f2l"],
          {"deformGroup":"", "deformationTriggerRatio":""},
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":""},
    ],
    "triangles":[
        ["id1:", "id2:", "id3:"],
        {"groundModel":"plastic"},
        //Dashboard
        {"dragCoef":0},
        ["dshl", "f6ll", "f5ll"],
        ["f6ll", "dshl", "f6l"],
        ["f6l",  "dshl", "dsh"],
        ["dsh",  "f6r",  "f6l"],
        ["dsh",  "dshr", "f6r"],
        ["f6r",  "dshr", "f6rr"],
        ["dshr", "f5rr", "f6rr"],
        ["dshl", "f5ll", "f5l"],
        ["f5l",  "dsh",  "dshl"],
        ["f5l",  "f5r",  "dsh"],
        ["dsh",  "f5r",  "dshr"],
        ["dshr", "f5r",  "f5rr"],
    ],
},

"bastion_sunvisors": {
    "information":{
        "authors":"BeamNG",
        "name":"Sunvisors",
        "value":180,
    },
    "slotType" : "bastion_sunvisors",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["bastion_sunvisor_mounts", ["bastion_body"]],
    ],
    "props": [
        ["func",       "mesh",               "idRef:", "idX:", "idY:",  "baseRotation",            "rotation",               "translation",          "min", "max", "offset", "multiplier"],
        ["sunvisor_L_movement","bastion_sunvisor_L","rf1","rf1l","rf2",{"x":0,"y":0,"z":0},{"x":-190,"y":0,"z":0},{"x":0,"y":0,"z":0},0,1,0,1,{"baseRotationGlobal":{"x":0,"y":-3,"z":-7}}],
        ["sunvisor_R_movement","bastion_sunvisor_R","rf1","rf1r","rf2",{"x":0,"y":0,"z":0},{"x":-190,"y":0,"z":0},{"x":0,"y":0,"z":0},0,1,0,1,{"baseRotationGlobal":{"x":0,"y": 3,"z": 7}}],
    ],
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
                ["sunvisor_L","",0],
                ["sunvisor_R","",0],
                ["sunvisor_L_movement","min(1, max(0, electrics.sunvisor_L_movement + electrics.sunvisor_L * dt))",0],
                ["sunvisor_R_movement","min(1, max(0, electrics.sunvisor_R_movement + electrics.sunvisor_R * dt))",0],
            ]
        }
    },
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["sunvisor_L", "rf1","rf1l","rf2", "box", {"x":0.384, "y":0.03, "z":0.03}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"mesh":"bastion_sunvisor_L", "baseTranslationGlobal":{"x":0.164, "y":-0.282, "z":1.368}}],
        ["sunvisor_R", "rf1","rf1r","rf2", "box", {"x":0.384, "y":0.03, "z":0.03}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"mesh":"bastion_sunvisor_R", "baseTranslationGlobal":{"x":-0.162, "y":-0.279, "z":1.338}}],
    ],
    "actionsEnabled": [
        ["id"],
        ["sunvisor_L_open"],
        ["sunvisor_R_open"],
        ["sunvisor_L_close"],
        ["sunvisor_R_close"],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["sunvisor_L", "action0", "sunvisor_L_open"],
        ["sunvisor_R", "action0", "sunvisor_R_open"],
        ["sunvisor_L", "action2", "sunvisor_L_close"],
        ["sunvisor_R", "action2", "sunvisor_R_close"],
    ],
},
