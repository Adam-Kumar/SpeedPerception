"bastion_gauges_luxe": {
    "information":{
        "authors":"BeamNG",
        "name":"Standard Gauges",
        "value":400,
    },
    "slotType" : "bastion_gauges",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["bastion_gauges", ["bastion_dash"]],
        ["bastion_decals_gauges_lux", ["bastion_dash"]],
    ],
    "glowMap":{
            "bastion_gauges":{"simpleFunction":{"lowhighbeam":0.49}, "off":"bastion_gauges_luxe", "on":"bastion_gauges_luxe_on"},
            "bastion_gps_screen":{"simpleFunction":{"ignitionLevel":0.1, "lowhighbeam":1}, "off":"screen_off","on":"bastion_gps_screen", "on_intense":"bastion_gps_screen_dim"},
            //gauge lights
            "signal_L":{"simpleFunction":"signal_L", "off":"invis", "on":"bastion_decals_gauges"},
            "signal_R":{"simpleFunction":"signal_R", "off":"invis", "on":"bastion_decals_gauges"},
            "esc":{"simpleFunction":{"esc":0.49,"tcs":0.49}, "off":"invis", "on":"bastion_decals_gauges"},
            "lowhighbeam":{"simpleFunction":"lowhighbeam", "off":"invis", "on":"bastion_decals_gauges"},
            "highbeam":{"simpleFunction":"highbeam", "off":"invis", "on":"bastion_decals_gauges"},
            "parkingbrake":{"simpleFunction":"parkingbrakelight", "off":"invis", "on":"bastion_decals_gauges"},
            "checkengine":{"simpleFunction":"checkengine", "off":"invis", "on":"bastion_decals_gauges"},

            //unused ones
            "doors":{"simpleFunction":"doors", "off":"invis", "on":"bastion_decals_gauges"},
            "seatbelt":{"simpleFunction":"seatbelt", "off":"invis", "on":"bastion_decals_gauges"},
            //disabled
            "abs":{"simpleFunction":"abs", "off":"invis", "on":"invis"},
    },
    "props": [
        ["func",       "mesh",               "idRef:", "idX:", "idY:",  "baseRotation",            "rotation",               "translation",          "min", "max", "offset", "multiplier"],
        //needles
        ["wheelspeed",  "bastion_speedometer_needle", "f5l","f5r","f6l",      {"x":-69.5, "y":0, "z":180}, {"x":0, "y":0, "z":-3.5},  {"x":0, "y":0, "z":0},   0, 85, 25, 0.966],
        ["rpm",    "bastion_tachometer_needle",  "f5l","f5r","f6l",      {"x":-69.5, "y":0, "z":180}, {"x":0, "y":0, "z":-0.0215}, {"x":0, "y":0, "z":0},  0, 14000, 4100, 1.8],
    ],
},
